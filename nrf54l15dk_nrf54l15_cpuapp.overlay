&pwm20 {
    status="disabled";
};
&led1 {
    status="disabled";
};

/ {
    chosen {
        zephyr,console = &uart30;
        zephyr,shell-uart = &uart30;
        zephyr,uart-mcumgr = &uart30;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        };
    };

    buttons {
        compatible = "gpio-keys";
        button0: button_0 {
            gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    aliases {
        led0 = &led0;
        button0 = &button0;
        lora0 = &sx1262;
    };
};

&button2 {
    status = "disabled";
};

&led3 {
    status = "disabled";
};


&spi00 {
    status = "disabled";
};

&uart30 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart30_default>;
    pinctrl-1 = <&uart30_sleep>;
    pinctrl-names = "default", "sleep";
};

&uart20 {
    status = "disabled";
};

&spi20 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi20_default>;
    pinctrl-1 = <&spi20_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
    sx1262: sx1262@0 {
        compatible = "semtech,sx1262";
        reg = <0>;
        spi-max-frequency = <DT_FREQ_M(2)>;
        reset-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
        dio1-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
        busy-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
        dio2-tx-enable;
    };
};

// &lfxo {
//     load-capacitors = "external";
// };

// &hfxo {
//     load-capacitors = "external";
// };

&pinctrl {
    uart30_default: uart30_default {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 0)>,
                    <NRF_PSEL(UART_TX, 0, 1)>;
            bias-pull-up;
        };
    };
    uart30_sleep: uart30_sleep {
        group1 {
            psels = <NRF_PSEL(UART_RX, 0, 0)>,
                    <NRF_PSEL(UART_TX, 0, 1)>;
            low-power-enable;
        };
    };

    spi20_default: spi20_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 5)>,
                    <NRF_PSEL(SPIM_MISO, 1, 4)>;
        };
    };

    spi20_sleep: spi20_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 5)>,
                    <NRF_PSEL(SPIM_MISO, 1, 4)>;
            low-power-enable;
        };
    };
};
